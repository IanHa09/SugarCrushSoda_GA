OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_SURVEY_MODEL=gpt-4o-mini
FULL_IMAGE_DETAIL=low
BOARD_IMAGE_DETAIL=high
LLM_MAX_OUTPUT_TOKENS=600
SURVEY_LLM_MAX_OUTPUT_TOKENS=900
AUTO_GRID=true
MONITOR_INDEX=1
CAPTURE_MODE=window
DRY_RUN=true
GAME_WINDOW_TITLE=
# 클릭 정확도: 누르기 직전 확대 재확인(true/false)과 그때 쓰는 모델
TAP_REFINE=true
OPENAI_TAP_MODEL=gpt-4.1-mini
# 확대본에서 못 찾으면 전체 화면으로 한 번 더 찾기(실측에서 엉뚱한 좌표가 나와 기본 끔)
TAP_REFINE_FULL_FALLBACK=false
# 프론티어가 바닥나면 실패로 닫힌 항목(화면 그대로·못 찾음·길 막힘)을 항목마다 이 횟수까지 다시 시도. 0이면 끔
FRONTIER_RETRY_MAX=1
# 막혔을 때 보낼 Android 뒤로. ADB_PATH가 있으면 adb로 보냅니다(권장, 따옴표 없이 전체 경로).
# 예) ADB_PATH=C:\LDPlayer\LDPlayer14\adb.exe
# 에뮬레이터가 여러 개면 ADB_SERIAL에 `adb devices`에 나온 이름(예: emulator-5554)을 적습니다.
ADB_PATH=
ADB_SERIAL=
# ADB_PATH가 비어 있을 때만 쓰는 키보드 키(LDPlayer는 ESC가 뒤로로 동작하지 않았음). 빈 값이면 끔
BACK_KEY=
# 탈출 사다리: 뒤로 → 나가기 요소 찾기 → 닫기류 다시 누르기 → 다시 분석 → 다른 버튼 → 게임 재시작(adb 필요)
ESCAPE_EXIT_FINDER=true
# 새 화면을 처음 볼 때 나가기 요소 찾기를 한 번 돌려 X·닫기·홈 탭을 버튼 후보에 더함(조사 모델이 자주 빠뜨림)
NEW_SCREEN_EXIT_FINDER=true
# 막혔을 때 종료하기 전에: 막힘 설명을 붙여 다시 분석(화면당 1번) → 그 화면의 다른 버튼을 이 개수까지 눌러봄
STUCK_RESURVEY=true
STUCK_OTHER_BUTTONS_MAX=4
# 새 화면·새 버튼 없이 이 스텝 수 동안 화면 2개 이하만 오가면 막힌 것으로 봄(0이면 끔)
STUCK_CYCLE_STEPS=6
GAME_PACKAGE=com.king.candycrushsodasaga
APP_RESTART_MAX=2
APP_RESTART_WAIT=20
# 공통 UI(네비게이션 바) 감지와, 같은 화면 판정에서 그 영역 빼기
CHROME_DETECTION=true
CHROME_MASK_IDENTITY=true
# 게임 지식: knowledge/games.txt에서 이 제목으로 장르를 찾고 UI 지식·화면 타입을 씁니다
GAME_TITLE=Candy Crush Soda Saga
# 플레이 정책: avoid(플레이 진입 버튼은 안 누르고, 플레이 화면에 들어가면 나옴) | handoff(나중에 플레이 코드로 넘길 자리, 지금은 avoid와 같음)
PLAY_POLICY=avoid
