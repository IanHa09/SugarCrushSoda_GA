OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_SURVEY_MODEL=gpt-4o-mini
FULL_IMAGE_DETAIL=low
BOARD_IMAGE_DETAIL=high
LLM_MAX_OUTPUT_TOKENS=600
SURVEY_LLM_MAX_OUTPUT_TOKENS=900
AUTO_GRID=true
MONITOR_INDEX=1
CAPTURE_MODE=window
DRY_RUN=true
GAME_WINDOW_TITLE=
# 클릭 정확도: 누르기 직전 확대 재확인(true/false)과 그때 쓰는 모델
TAP_REFINE=true
OPENAI_TAP_MODEL=gpt-4.1-mini
# 막혔을 때 보낼 Android 뒤로. ADB_PATH가 있으면 adb로 보냅니다(권장, 따옴표 없이 전체 경로).
# 예) ADB_PATH=C:\LDPlayer\LDPlayer14\adb.exe
# 에뮬레이터가 여러 개면 ADB_SERIAL에 `adb devices`에 나온 이름(예: emulator-5554)을 적습니다.
ADB_PATH=
ADB_SERIAL=
# ADB_PATH가 비어 있을 때만 쓰는 키보드 키(LDPlayer는 ESC가 뒤로로 동작하지 않았음). 빈 값이면 끔
BACK_KEY=
# 탈출 사다리: 뒤로 → 나가기 요소 찾기 → 닫기류 다시 누르기 → 게임 재시작(adb 필요)
ESCAPE_EXIT_FINDER=true
GAME_PACKAGE=com.king.candycrushsodasaga
APP_RESTART_MAX=2
APP_RESTART_WAIT=20
# 공통 UI(네비게이션 바) 감지와, 같은 화면 판정에서 그 영역 빼기
CHROME_DETECTION=true
CHROME_MASK_IDENTITY=true
